# Bharat Krishi Intelligence Grid (BKIG) Frontend Environment Configuration

# FastAPI Backend Base URL
# When the backend is running locally (e.g., uvicorn app.main:app --reload --port 8000)
VITE_API_BASE_URL=http://localhost:8000

# Toggle Mock Data Mode (true: use rich mock datasets; false: connect to real backend API)
VITE_USE_MOCK=true
